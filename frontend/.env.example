# CloudDeploy Frontend Environment Configuration Example
# Public identifiers only. Never commit AWS secrets, access keys, or database passwords.

# Centralized Spring Boot API Backend URL
VITE_API_BASE_URL=http://localhost:8080/api

# Demo Simulation Mode (false = live backend API, true = mocked AWS pipeline for offline evaluation)
VITE_DEMO_MODE=false

# Amazon Cognito Public Configuration (Optional when using BFF pattern or Direct Cognito SRP)
VITE_COGNITO_USER_POOL_ID=ap-south-1_examplePoolId
VITE_COGNITO_CLIENT_ID=exampleAppClientId12345
VITE_COGNITO_REGION=ap-south-1
