# CloudDeploy Backend Environment Template Example
# Never place real AWS access keys, secret keys, or database passwords in this file.
# In production on AWS EC2, credentials are automatically resolved via IAM Instance Profile.

# Active Spring Profile (local, prod)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# AWS Programmatic Access Credentials (For local development; In EC2 prod IAM Role is used)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS Region & Identity
AWS_REGION=ap-south-1
AWS_COGNITO_USER_POOL_ID=ap-south-1_examplePoolId
AWS_COGNITO_CLIENT_ID=exampleClientId123
AWS_COGNITO_REGION=ap-south-1

# Amazon S3 Buckets
AWS_S3_UPLOAD_BUCKET=clouddeploy-uploads-staging-example
AWS_S3_SITE_BUCKET=clouddeploy-sites-published-example

# Amazon CloudFront Distribution
AWS_CLOUDFRONT_DISTRIBUTION_ID=E1EXAMPLECLOUDFRONT
AWS_CLOUDFRONT_DOMAIN=d111111abcdef8.cloudfront.net

# Amazon RDS MySQL (For Production Profile)
RDS_HOSTNAME=clouddeploy-db.cluster-custom.ap-south-1.rds.amazonaws.com
RDS_PORT=3306
RDS_DB_NAME=clouddeploy
RDS_USERNAME=clouddeploy_admin
RDS_PASSWORD=

# AWS Secrets Manager Secret ARN (Stores RDS credentials)
AWS_RDS_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:clouddeploy/rds/credentials-AbCdEf

# CloudWatch & SNS
AWS_CLOUDWATCH_LOG_GROUP=/aws/clouddeploy/application
AWS_SNS_ALERTS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:clouddeploy-ops-alerts

# CloudDeploy Quotas and Routing Domain
APP_BASE_DOMAIN=sites.clouddeploy.internal
APP_UPLOAD_MAX_BYTES=52428800
APP_MAX_FILES_PER_DEPLOYMENT=1000
APP_MAX_EXTRACTED_BYTES=262144000
APP_MAX_PROJECTS_PER_USER=10
JWT_SECRET=change-this-jwt-secret-in-production-environments-32-chars
